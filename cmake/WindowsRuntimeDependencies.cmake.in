# Runs after Qt deployment, including under CPack's private install prefix.
cmake_minimum_required(VERSION 3.30)
set(stage "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(qt_prefix "@LOGI_QT_PREFIX@")
set(compiler_bin "@LOGI_COMPILER_BIN@")
set(msys_root "@LOGI_MSYS_ROOT@")
set(pacman "@LOGI_PACMAN@")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
if("@CMAKE_OBJDUMP@" AND EXISTS "@CMAKE_OBJDUMP@")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
endif()
file(GLOB executables "${stage}/*.exe")
file(GLOB libraries "${stage}/*.dll")
file(GLOB_RECURSE all_dlls "${stage}/*.dll")
set(modules ${all_dlls})
list(REMOVE_ITEM modules ${libraries})
# SystemRoot is case-insensitive on Windows. Escape it without excluding DLLs
# merely because they happen to have the same name as a system component.
file(TO_CMAKE_PATH "$ENV{SystemRoot}" system_root)
set(system_regex "^")
string(LENGTH "${system_root}" root_length)
math(EXPR root_last "${root_length}-1")
foreach(index RANGE ${root_last})
    string(SUBSTRING "${system_root}" ${index} 1 letter)
    if(letter MATCHES "[A-Za-z]")
        string(TOLOWER "${letter}" lower)
        string(TOUPPER "${letter}" upper)
        string(APPEND system_regex "[${lower}${upper}]")
    elseif(letter STREQUAL "/")
        string(APPEND system_regex "[/\\\\]")
    else()
        string(APPEND system_regex "${letter}")
    endif()
endforeach()
string(APPEND system_regex "[/\\\\]")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${executables}
    LIBRARIES ${libraries}
    MODULES ${modules}
    DIRECTORIES "${stage}" "${qt_prefix}/bin" "${compiler_bin}"
    PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
    POST_EXCLUDE_REGEXES "${system_regex}"
    RESOLVED_DEPENDENCIES_VAR dependencies
    UNRESOLVED_DEPENDENCIES_VAR unresolved
    CONFLICTING_DEPENDENCIES_PREFIX conflicts)
if(unresolved OR conflicts_FILENAMES)
    message(FATAL_ERROR "Portable Windows dependencies unresolved: ${unresolved}; conflicts: ${conflicts_FILENAMES}")
endif()
file(MAKE_DIRECTORY "${stage}/licenses")
file(WRITE "${stage}/licenses/runtime-files.txt" "Recursively resolved Windows runtime libraries (OS libraries excluded):\n")
set(license_sources ${all_dlls} ${dependencies})
foreach(dependency IN LISTS dependencies)
    get_filename_component(name "${dependency}" NAME)
    if(NOT dependency STREQUAL "${stage}/${name}")
        file(INSTALL DESTINATION "${stage}" TYPE FILE FILES "${dependency}")
    endif()
    file(APPEND "${stage}/licenses/runtime-files.txt" "${name}\n")
endforeach()

# Query the actual package owning each shipped DLL. Copy its packaged license
# files instead of guessing a DLL-name-to-license table that will become stale.
if(EXISTS "${pacman}")
    set(packages)
    foreach(source IN LISTS license_sources)
        file(RELATIVE_PATH relative "${stage}" "${source}")
        if(NOT relative MATCHES "^\\.\\.")
            get_filename_component(name "${source}" NAME)
            if(EXISTS "${qt_prefix}/${relative}")
                set(source "${qt_prefix}/${relative}")
            elseif(EXISTS "${qt_prefix}/bin/${name}")
                set(source "${qt_prefix}/bin/${name}")
            elseif(EXISTS "${compiler_bin}/${name}")
                set(source "${compiler_bin}/${name}")
            endif()
        endif()
        file(RELATIVE_PATH relative "${msys_root}" "${source}")
        if(relative MATCHES "^\\.\\.")
            message(FATAL_ERROR "No package license provenance for runtime ${source}")
        endif()
        execute_process(COMMAND "${pacman}" -Qqo "/${relative}"
            OUTPUT_VARIABLE package OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot find MSYS2 runtime package owner: ${source}")
        endif()
        list(APPEND packages "${package}")
    endforeach()
    list(REMOVE_DUPLICATES packages)
    list(SORT packages)
    file(WRITE "${stage}/licenses/runtime-packages.txt" "MSYS2 package metadata for shipped runtime libraries.\nSource/build recipes: https://github.com/msys2/MINGW-packages\n\n")
    foreach(package IN LISTS packages)
        execute_process(COMMAND "${pacman}" -Qi "${package}" OUTPUT_VARIABLE metadata RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot read metadata for ${package}")
        endif()
        file(APPEND "${stage}/licenses/runtime-packages.txt" "${metadata}\n")
        execute_process(COMMAND "${pacman}" -Qlq "${package}" OUTPUT_VARIABLE owned RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot read license paths for ${package}")
        endif()
        string(REPLACE "\n" ";" owned "${owned}")
        foreach(path IN LISTS owned)
            string(STRIP "${path}" path)
            if(path MATCHES "/share/licenses/(.+)$" AND NOT IS_DIRECTORY "${msys_root}${path}")
                set(license_relative "${CMAKE_MATCH_1}")
                get_filename_component(directory "${license_relative}" DIRECTORY)
                file(INSTALL DESTINATION "${stage}/licenses/${directory}" TYPE FILE FILES "${msys_root}${path}")
            endif()
        endforeach()
    endforeach()
    if(EXISTS "${msys_root}/usr/share/licenses/common")
        file(INSTALL DESTINATION "${stage}/licenses" TYPE DIRECTORY FILES "${msys_root}/usr/share/licenses/common")
    endif()
else()
    message(WARNING "MSYS2 package database unavailable; add the toolchain's runtime license texts before redistribution")
endif()
list(LENGTH dependencies count)
message(STATUS "Bundled complete Windows dependency graph: ${count} non-system libraries")
