[Unit]
Description=Logi Options Open experimental mouse mappings
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/logi-cli run
Restart=on-abnormal
RestartSec=2s
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
